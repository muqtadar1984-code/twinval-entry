# Database
DATABASE_URL=postgresql+psycopg2://twinval:twinval@localhost:5432/twinval_portal

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=14

# Initial admin (auto-created on first boot if no admin exists)
INITIAL_ADMIN_EMAIL=admin@twinval.com
INITIAL_ADMIN_PASSWORD=change-me-on-first-login
INITIAL_ADMIN_NAME=TwinVal Admin

# CORS — comma-separated origins
CORS_ORIGINS=http://localhost:5173,https://twinval.com

# Object storage (Cloudflare R2 — S3-compatible)
S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=twinval-portal-photos
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_PUBLIC_BASE_URL=https://photos.twinval.com

# Hash chain
GENESIS_SEED=TWINVAL_GENESIS_IIUM_PILOT

# Rate limiting
LOGIN_RATE_LIMIT=10/15minutes

# Photo upload
MAX_PHOTO_BYTES=5242880
ALLOWED_PHOTO_MIME_TYPES=image/jpeg,image/png,image/webp,image/heic
